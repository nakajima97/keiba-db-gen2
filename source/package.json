        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.1",
        "globals": "^15.15.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.1.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
